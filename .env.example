# ============================================================================
#  YOUR SECRETS  —  copy this file to ".env" and fill in the values.
#
#    Windows:   copy .env.example .env
#    Mac/Linux: cp .env.example .env
#
#  Then open ".env" in a text editor and paste your keys after each "=".
#  NEVER share your ".env" file or commit it to git — it holds your secrets.
#  (.env is already in .gitignore.)
#
#  Only the YouTube section is required to UPLOAD. Everything else is optional —
#  the app runs with free defaults if you leave them blank.
# ============================================================================


# ----------------------------------------------------------------------------
# 1) YOUTUBE  (required to upload — the app builds videos without it)
# ----------------------------------------------------------------------------
# YouTube uses an OAuth "client secret" FILE (not a key you paste here). You
# download it from Google Cloud Console once. See SETUP.md section 4 for the
# click-by-click. Save that downloaded file in the project folder and put its
# name below. The default is "client_secret.json".
#
# The first time you authorize a channel, a browser opens to sign in; the login
# is then cached to state/youtube_token*.json so future runs are unattended.
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=state/youtube_token.json


# ----------------------------------------------------------------------------
# 2) REDDIT  (optional — improves reliability of fetching posts)
# ----------------------------------------------------------------------------
# Leave blank and the app uses free public archives (arctic-shift / pullpush)
# automatically. Adding a free Reddit "script" app makes fetching faster and
# more reliable. Create one at: https://www.reddit.com/prefs/apps
#   - type: "script"
#   - redirect uri: http://localhost:8080  (required field, otherwise unused)
#   - client_id = the short string shown UNDER the app name
#   - secret    = the "secret" field
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=shorts-bot/1.0 by u/YOUR_REDDIT_USERNAME


# ----------------------------------------------------------------------------
# 3) ELEVENLABS  (optional — premium narration voice)
# ----------------------------------------------------------------------------
# Leave blank to use the free built-in "edge-tts" voice (sounds great already).
# A key unlocks the ElevenLabs premium voice configured in config.yaml.
# Get a key (free tier available): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=


# ----------------------------------------------------------------------------
# 4) LLM SCRIPT POLISH  (optional — only if you set script.use_llm: true)
# ----------------------------------------------------------------------------
# Leave blank unless you turn on LLM rewriting in config.yaml. Provide ONE key
# matching config.yaml's script.llm_provider (anthropic OR openai).
#   Anthropic (Claude): https://console.anthropic.com/settings/keys
#   OpenAI:             https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=


# ----------------------------------------------------------------------------
# 5) ADVANCED  (optional — only if FFmpeg isn't found automatically)
# ----------------------------------------------------------------------------
# The app finds ffmpeg/ffprobe on your PATH automatically. Only set these if
# the checker says they're missing AND you don't want to add them to PATH —
# point them at the full path to each .exe.
# FFMPEG_BIN=C:\path\to\ffmpeg.exe
# FFPROBE_BIN=C:\path\to\ffprobe.exe
